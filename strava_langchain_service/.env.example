# Copy to .env, then export it before starting the server:
# set -a; source .env; set +a

# Token carrying activity:read_all. Add activity:write for optional TCX upload,
# and profile:read_all only for /zones.
STRAVA_ACCESS_TOKEN=

# OAuth access token carrying the Calendar scope below. GOOGLE_ACCESS_TOKEN is
# accepted as a compatibility fallback when this dedicated value is unset.
# https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional LangChain/Claude chat endpoint. Tool routes work without these.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Required protection for /v1 routes. Postman sends this as a Bearer token.
RUNSENSE_API_KEY=change-me

STRAVA_API_BASE_URL=https://www.strava.com/api/v3
GOOGLE_CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3
