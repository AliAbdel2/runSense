{
  "info": {
    "_postman_id": "26dc1d37-b2aa-4dc9-b750-runsense-calendar",
    "name": "RunSense Google Calendar + LangChain",
    "description": "Exercises the exact Google Calendar tools offered to the RunSense AI agent. No secret values are included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{runsense_api_key}}", "type": "string"}]
  },
  "item": [
    {
      "name": "List LangChain Tools",
      "request": {"method": "GET", "url": "{{service_base_url}}/v1/tools"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Calendar tools are listed', () => {",
        "  pm.response.to.have.status(200);",
        "  const names = pm.response.json().tools.map(tool => tool.name);",
        "  pm.expect(names).to.include('calendar_create_session');",
        "  pm.expect(names).to.include('calendar_check_guide');",
        "});"
      ]}}]
    },
    {
      "name": "Create Session Tool",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"arguments\": {\n    \"title\": \"RunSense intervals\",\n    \"start\": \"{{calendar_start}}\",\n    \"end\": \"{{calendar_end}}\",\n    \"time_zone\": \"Europe/Zurich\",\n    \"idempotency_key\": \"{{calendar_idempotency_key}}\",\n    \"owner_confirmed\": true,\n    \"description\": \"Four by eight hundred metres. Guide invitation is provisional.\",\n    \"location\": \"Letzigrund track\",\n    \"session_type\": \"intervals\",\n    \"venue_type\": \"track\",\n    \"guide_email\": \"{{guide_email}}\",\n    \"reminder_minutes\": [60, 10]\n  }\n}"},
        "url": "{{service_base_url}}/v1/tools/calendar_create_session/invoke"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Event was created or safely updated', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.environment.set('calendar_event_id', body.result.event_id);",
        "pm.expect(body.result.guide_status).to.eql('pending');"
      ]}}]
    },
    {
      "name": "Read Back Session",
      "request": {"method": "GET", "url": "{{service_base_url}}/v1/calendar/events/{{calendar_event_id}}"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Calendar event read back', () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().event_id).to.eql(pm.environment.get('calendar_event_id'));"
      ]}}]
    },
    {
      "name": "Check Guide RSVP Tool",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"arguments\": {\n    \"event_id\": \"{{calendar_event_id}}\",\n    \"guide_email\": \"{{guide_email}}\"\n  }\n}"},
        "url": "{{service_base_url}}/v1/tools/calendar_check_guide/invoke"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Guide status returned', () => pm.response.to.have.status(200));",
        "pm.expect(['accepted', 'declined', 'tentative', 'pending', 'not_invited']).to.include(pm.response.json().result.guide_status);"
      ]}}]
    },
    {
      "name": "Ask Agent to Create a Safe Session",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"question\": \"Create a treadmill run for 15 September 2026 from 09:00 to 10:00 Europe/Zurich, with reminders 60 and 10 minutes before.\"\n}"},
        "url": "{{service_base_url}}/v1/agent/chat"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Agent answered or reports missing Claude config', () => pm.expect([200, 502]).to.include(pm.response.code));"
      ]}}]
    }
  ]
}
