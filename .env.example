# These are examples only. Docker Compose loads a root .env automatically;
# direct uvicorn runs require values exported in the launching terminal.
# Never commit actual keys.
RUNSENSE_DB=data/runsense.sqlite3
# Keep the default localhost-only allowlist. For same-Wi-Fi phone testing,
# add the computer's LAN IP/hostname after binding uvicorn to 0.0.0.0.
# RUNSENSE_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.23
# Protects provider-backed /v1 routes. The Flutter RUNSENSE_API_KEY dart-define
# must match this value.
RUNSENSE_API_KEY=

# Optional Claude tool-use planner. Set a currently available model ID explicitly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google access-token bootstrap/refresh UI is not implemented yet.
# Requested scopes: spreadsheets.readonly and calendar.events.
GOOGLE_ACCESS_TOKEN=
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=Training!A1:E100
# Prefer a dedicated test calendar. All writes use sendUpdates=none, no attendees.
GOOGLE_CALENDAR_ID=primary

NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=
NOTION_VERSION=2026-03-11
NOTION_TITLE_PROPERTY=Name
NOTION_PLAN_ID_PROPERTY=Plan ID
NOTION_SUMMARY_PROPERTY=Summary

# Optional adapter; the dashboard uses browser speech and does not call this API.
# The tts_say tool does call it when all three are set. Clips are cached by a
# hash of text+voice+model, so repeating a cue never re-bills the provider.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
RUNSENSE_AUDIO_DIR=data/audio

# Optional SMS delivery. Leave unset and sms_notify reports "not_configured"
# instead of sending. Sending is not retried: Twilio has no idempotency key.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Destination for the guide-cancellation reschedule notice. No SMS is sent
# unless this and the three Twilio values above are all set.
RUNSENSE_GUIDE_PHONE=

# Official Strava MCP personal-use path. This is an MCP OAuth token, NOT a
# Strava REST API access token. No token or activity data is written to disk.
STRAVA_MCP_ACCESS_TOKEN=
# Run Check access in the dashboard, then use a name/schema it actually returns.
STRAVA_MCP_ACTIVITY_TOOL=
STRAVA_MCP_ACTIVITY_ARGUMENTS_JSON={}
# Mapping inside CallToolResult.structuredContent or a single JSON text block.
# Configure these from your discovered tool result; defaults are examples only.
STRAVA_MCP_ROWS_POINTER=/activities
STRAVA_MCP_DATE_FIELD=start_date_local
STRAVA_MCP_DISTANCE_FIELD=distance
STRAVA_MCP_DISTANCE_UNIT=meters
STRAVA_MCP_SPORT_FIELD=sport_type
STRAVA_MCP_ID_FIELD=id

# Optional Strava REST integration used by /v1/strava and live TCX uploads.
# Keep this separate from the official MCP personal-use planning source.
STRAVA_ACCESS_TOKEN=
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_API_BASE_URL=https://www.googleapis.com/calendar/v3
